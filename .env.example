# LoraQwen Forge — configuration
# Copy to .env (`copy .env.example .env`). Relative paths are resolved
# against the project root, so the app works from any working directory.

# ── web app ──────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=5000

# ── inference engine (llama-server) ──────────────────────
ENGINE_PORT=8088
ENGINE_URL=http://127.0.0.1:8088
LLAMA_CPP_DIR=llama.cpp
DEFAULT_CTX=8192
DEFAULT_NGL=999
DEFAULT_PARALLEL=2
DEFAULT_MODEL=Qwen/Qwen3-8B

# ── external generation endpoint ─────────────────────────
LMSTUDIO_URL=http://localhost:1234

# ── built-in TTS voices (Kokoro) ──────────────────────────
# Two model files, not on PyPI -- download from the kokoro-onnx releases
# (https://github.com/thewh1teagle/kokoro-onnx) and drop them in
# data/kokoro/, or point these at an existing copy elsewhere. Unset, they
# default to data/kokoro/kokoro_v1.onnx and voices_v1.bin.
# KOKORO_MODEL_PATH=
# KOKORO_VOICES_PATH=

# ── directories ──────────────────────────────────────────
# These are resolved against data/ (content) and runtime/ (binaries and
# scratch) automatically -- give a bare folder name, or an absolute path
# to put something on another drive.
CHARACTERS_DIR=characters
DATASETS_DIR=datasets
DPO_DIR=dpo_data
LORAS_DIR=loras
GGUF_DIR=gguf_output
MODELS_DIR=models
TRAINING_INPUT=training_input
VOICE_SAMPLES=voice_samples
EVAL_DIR=evals
IPC_DIR=.train_ipc
HF_HOME=.hf_temp_cache
LORA_ENV=lora_env
VOICE_ENV=voice_env

# ── chat defaults ────────────────────────────────────────
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=512
CHAT_TOP_P=0.95

# ── feed defaults ────────────────────────────────────────
FEED_MAX_POSTS=200
FEED_THINK_TEMP=0.9
FEED_POST_TEMP=0.85
FEED_THINK_TOKENS=120
FEED_POST_TOKENS=150
# Off by default: saving every post back as a memory feeds the bot its own
# output and flattens the character over a long session.
FEED_AUTO_MEMORIZE=false
FEED_MEMORY_CAP=60

# ── generation defaults ──────────────────────────────────
GEN_TOTAL=300
GEN_BATCH=8
GEN_TEMPERATURE=0.9
GEN_TIMEOUT_S=240
GEN_DEDUPE=0.62
GEN_SUPERVISE_PCT=0

# ── training defaults ────────────────────────────────────
TRAIN_SEQ_LEN=1024
TRAIN_RANK=16
TRAIN_ALPHA=32
TRAIN_DROPOUT=0.05
TRAIN_EPOCHS=3
TRAIN_BATCH=2
TRAIN_GRAD_ACCUM=4
TRAIN_LR=0.00015
TRAIN_WARMUP=0.03
TRAIN_SCHEDULER=cosine
TRAIN_LOG_STEPS=5
TRAIN_SAVE_STEPS=200
TRAIN_EVAL_SPLIT=10
TRAIN_SEED=42
TRAIN_TARGETS=q_proj,k_proj,v_proj,o_proj
